# Copy to keystore.properties and fill in. keystore.properties is gitignored — never commit it,
# and never commit the .jks/.keystore file it points at either.
#
# To create a release keystore (once, and then back it up somewhere you will not lose it — losing
# it means you can never update the app on Play under the same package):
#
#   keytool -genkeypair -v -keystore anfas-release.jks \
#     -alias anfas -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to the repository root (see androidApp/build.gradle.kts).
# When absent, release falls back to debug signing so a fresh clone still builds — a convenience,
# never a shipping path. Confirm what actually signed an APK with:
#
#   apksigner verify --print-certs androidApp/build/outputs/apk/release/androidApp-release.apk

storeFile=anfas-release.jks
storePassword=
keyAlias=anfas
keyPassword=
